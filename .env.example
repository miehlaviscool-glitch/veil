# --- Required ---
DISCORD_TOKEN=
CLIENT_ID=

# --- Ownership ---
# Comma-separated Discord user IDs with full owner access.
# The Discord application owner / developer-team members are always owners too.
OWNER_IDS=

# --- Slash command deployment ---
# If set, commands are registered to this guild instantly (great for development).
# Leave empty to register globally (can take up to an hour to propagate).
DEV_GUILD_ID=
# Re-register commands automatically on startup when they changed.
AUTO_DEPLOY=true

# --- Web dashboard ---
DASHBOARD_ENABLED=true
# Keep 127.0.0.1 unless you put it behind a TLS reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Leave empty to auto-generate a token (printed at startup, stored in data/.dashboard-token).
DASHBOARD_TOKEN=

# --- Optional ---
# Webhook that receives guild join/leave events, errors and owner actions.
LOG_WEBHOOK_URL=
# DANGEROUS: enables the /eval command for OWNER_IDS only.
ENABLE_EVAL=false
LOG_LEVEL=info
